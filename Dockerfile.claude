FROM debian:trixie

ARG AGENTS_VERSION=main
ARG CODING_STANDARDS_VERSION=main
ARG CLAUDE_CODE_VERSION=2.1.220

WORKDIR /agent

RUN apt-get update && \
    apt-get install -y curl git build-essential golang-go python3 python3-pip \
        podman uidmap fuse-overlayfs passt slirp4netns

# rootless podman for the agent user: subuid/subgid ranges for user
# namespaces, fuse-overlayfs storage (plain overlay is unavailable
# inside a container) and a docker alias so agents can run either CLI
RUN echo "agent:100000:65536" >> /etc/subuid && \
    echo "agent:100000:65536" >> /etc/subgid && \
    printf '[storage]\ndriver = "overlay"\n\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
        > /etc/containers/storage.conf && \
    ln -s /usr/bin/podman /usr/local/bin/docker

# acceptance criteria use tags do organize cross-cutting feature files.
# agents need to link tagged scenarios to specs using the godog tool
RUN go install github.com/cucumber/godog/cmd/godog@latest

# clone repositories containing agent definitions and coding
# standards. stored in /etc as read-only so that agents cannot
# modify agent or standards definitions
RUN git clone https://github.com/PSauerborn/agents \
    --branch "${AGENTS_VERSION}" \
    /etc/agents

RUN git clone https://github.com/PSauerborn/coding-standards \
    --branch "${CODING_STANDARDS_VERSION}" \
    /etc/coding-standards

# create dedicated user for agent
RUN useradd -m agent
USER agent

WORKDIR /home/agent/workspace

# install claude as the agent user so the binary lands in this
# user's own ~/.local/bin (/root/.local/bin is unreachable: /root is 0700)
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"

# write claude config: bypass permission prompts (safe here — non-root user in sandbox)
COPY --chown=agent:agent .claude.docker.json /home/agent/.claude/settings.json

# podman's image storage cannot live on the image's own overlayfs
# (nested overlay breaks container exec), so declare it as a volume;
# pre-creating the directory as the agent user makes docker carry
# its ownership into the auto-provisioned volume. NOTE: nested
# containers require running this image with --privileged
RUN mkdir -p /home/agent/.local/share/containers
VOLUME /home/agent/.local/share/containers

ENV PATH="/home/agent/.local/bin:${PATH}"
ENV CODING_STANDARDS_DIR=/etc/coding-standards

CMD [ "claude", "--plugin-dir", "/etc/agents" ]
