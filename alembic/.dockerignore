# Everything the migration image does not need. The build context is the alembic/
# directory; only alembic.ini, migrations/, src/ and requirements.txt are copied.

# VCS
.git
.gitignore
.github

# Python caches and build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Documentation, automation and tests - none of it is used at run time
README.md
Makefile
docs/
acceptance/

# Local environment and editor state
.env
.env.*
.vscode/
.idea/
*.swp
.DS_Store

# Container definitions themselves
Dockerfile
.dockerignore
