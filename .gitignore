.vscode

.DS_Store

SPEC-*-REVIEW.md

# Python build artefacts
__pycache__/
*.py[cod]

# Go build artefacts
/api/api

# Node/Next.js build artefacts
/web/node_modules/
/web/.next/
/web/out/
# Regenerated by tsc/next build on every run
/web/tsconfig.tsbuildinfo
/web/next-env.d.ts
# Written by `next dev`; not project-authored documentation
/web/AGENTS.md
/web/CLAUDE.md
# Every local env file: Next.js loads .env, .env.development and .env.production
# as well as the .local variants, and any of them is a natural home for a real
# API origin or credential. The committed example is the one exception.
/web/.env*
!/web/.env.example

# Per-run byproducts of the subagent pipeline. Regenerable from the spec and
# work plan, and stale as soon as the changeset merges. The durable record —
# docs/specs, docs/plans/*-WP-*.md and docs/plans/designs — stays committed.
/docs/plans/manifests/
/docs/plans/quality/
/docs/plans/risk/
/docs/plans/tasks/
/docs/plans/changesets/
/docs/plans/designs/
