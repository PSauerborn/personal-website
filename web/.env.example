# Base URL of the API, read at RUNTIME by Server Components and route handlers.
# Changing it on a running container takes effect without a rebuild, so this is
# the value to set per environment (for example the in-network service address).
API_BASE_URL=http://localhost:8080

# Base URL of the API used by browser (client component) requests.
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME by `next build`: the literal
# string is substituted into the client bundle. Setting it in the runtime
# environment of an already-built image has NO EFFECT — it must be supplied as a
# build argument when the image is built.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Verbosity of the server-side log, read at RUNTIME on every record: one of
# debug, info, warn, error. Anything else falls back to info, so a typo here
# cannot take the process down. Records are JSON, one per line, on stdout.
LOG_LEVEL=info
